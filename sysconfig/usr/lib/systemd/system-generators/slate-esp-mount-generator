#!/bin/sh
set -euo pipefail

EFIVAR="/sys/firmware/efi/efivars/LoaderDevicePartUUID-4a67b082-0a4c-41cf-b6c7-440b29bb8c4f"

[ -e "$EFIVAR" ] || exit 0
PARTUUID=$(dd if="$EFIVAR" conv=lcase bs=1 skip=4 count=72 2>/dev/null | tr -d '\0')
[ "$PARTUUID" ] || exit 0
DEVICE=dev/disk/by-partuuid/$PARTUUID
[ -e "/$DEVICE" ] || exit 0
ESCAPED=$(systemd-escape $DEVICE)

cat <<EOF > "$3/boot.automount"
# Automatically generated by slate-esp-mount-generator
[Unit]
SourcePath=$EFIVAR

[Automount]
Where=/boot
EOF

cat <<EOF > "$3/boot.mount"
# Automatically generated by slate-esp-mount-generator
[Unit]
Description=EFI System Partition
SourcePath=$EFIVAR
Before=local-fs.target
After=blockdev@${ESCAPED}.target

[Mount]
What=/${DEVICE}
Where=/boot
Type=vfat
Options=nofail,fmask=0177,dmask=0077,nodev,nosuid,noexec,x-systemd.automount
EOF

mkdir -p "$3/local-fs.target.wants"
ln -s "$3/boot.automount" "$3/local-fs.target.wants/boot.automount"
